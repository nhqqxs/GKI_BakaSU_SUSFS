+/*
+ * status 节点暴露的是 5 个 u32：version/sequence/enforcing/policyload/deny_unknown。
+ * KernelSU 重载策略走 avc_ss_reset 直连路径，不会同步这个页，
+ * 于是出现 "sequence 被顶高、policyload 不动" 的分裂，
+ * 被当成"策略被改动过"的证据。
+ *
+ * 期望值随内核版本变化（见 torvalds/fc983171e4c8）：
+ *   6.10+ ：首次安全策略加载也会走 policyload 通知，稳定态是 sequence=4, policyload=1
+ *   < 6.10：首次加载不发通知，稳定态是 sequence=0, policyload=0
+ * 这里按下编译内核的版本给出对应组合，跟检测方的判据对齐。
+ */
+static struct page *zn_fake_status __read_mostly;
+
+static void zn_init_fake_status(struct selinux_state *state)
+{
+	struct selinux_kernel_status *st;
+	struct page *real;
+	struct page *fake;
+
+	if (zn_fake_status)
+		return;
+
+	real = selinux_kernel_status_page(state);
+	if (!real)
+		return;
+
+	fake = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!fake)
+		return;
+
+	st = page_address(fake);
+	memcpy(st, page_address(real), sizeof(*st));
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+	st->sequence = 4;
+	st->policyload = 1;
+#else
+	st->sequence = 0;
+	st->policyload = 0;
+#endif
+	st->enforcing = 1;
+	st->deny_unknown = 1;
+
+	zn_fake_status = fake;
+}
+
