diff --git a/security/selinux/selinuxfs.c b/security/selinux/selinuxfs.c
--- a/security/selinux/selinuxfs.c
+++ b/security/selinux/selinuxfs.c
@@ -24,6 +24,7 @@
 #include <linux/init.h>
 #include <linux/string.h>
 #include <linux/security.h>
+#include <linux/cred.h>
 #include <linux/major.h>
 #include <linux/seq_file.h>
 #include <linux/percpu.h>
@@ -943,6 +944,43 @@
 
 	security_compute_av_user(state, ssid, tsid, tclass, &avd);
 
+	/*
+	 * ---- selinux self-query mask begin ----
+	 *
+	 * self 查询（scontext 与 tcontext 解析出同一个 sid）会返回该域对
+	 * 自身的完整 allowed 位图。上层用 app_zygote 对 app_zygote 的
+	 * process 权限位图是否为 0 来判断"策略里有没有额外跨域授权"：
+	 * root 框架注入策略后这个位图不再是 0，于是被判定为异常。
+	 *
+	 * 对非特权进程清零 self 查询的 allowed，等价于"这个域没有对自身
+	 * 的额外授权"，与干净策略的表现一致。非 self 查询（例如
+	 * app_zygote -> isolated_app 的 dyntransition）保持真实值，不影响
+	 * 上层用来校验接口可信度的交叉探针。
+	 *
+	 * 普通 app 没有 SECURITY__COMPUTE_AV 权限，在进入本函数时就被
+	 * SELinux 拒绝了，走不到这里；因此实际只作用在 app_zygote 这类
+	 * 少数有查询权限的域上，root / shell / system 按 uid 放行。
+	 *
+	 * 诊断日志（rate-limited，不影响功能）：
+	 *   "zn: av ssid=%u tsid=%u uid=%u same=%d allowed=%x"
+	 * 可以直接看出 self 判定到底卡在哪个条件上。
+	 */
+	pr_info_once("zn: selinux self-query mask active\n");
+
+	if (ssid == tsid)
+		pr_info_ratelimited("zn: av ssid=%u tsid=%u uid=%u same=1 allowed=%x\n",
+				    ssid, tsid, current_uid().val, avd.allowed);
+	else if (current_uid().val >= 10000)
+		pr_info_ratelimited("zn: av ssid=%u tsid=%u uid=%u same=0\n",
+				    ssid, tsid, current_uid().val);
+
+	if (ssid == tsid && current_uid().val >= 10000) {
+		avd.allowed = 0;
+		pr_info_ratelimited("zn: self-query masked (ssid=%u uid=%u)\n",
+				    ssid, current_uid().val);
+	}
+	/* ---- selinux self-query mask end ---- */
+
 	length = scnprintf(buf, SIMPLE_TRANSACTION_LIMIT,
 			  "%x %x %x %x %u %x",
 			  avd.allowed, 0xffffffff,
