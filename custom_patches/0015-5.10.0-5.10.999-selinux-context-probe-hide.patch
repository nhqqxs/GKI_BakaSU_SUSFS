diff --git a/security/selinux/selinuxfs.c b/security/selinux/selinuxfs.c
--- a/security/selinux/selinuxfs.c
+++ b/security/selinux/selinuxfs.c
@@ -674,6 +674,55 @@
 	.llseek		= generic_file_llseek,
 };
 
+/*
+ * ---- selinuxfs probe hide begin ----
+ *
+ * /sys/fs/selinux/context 和 /sys/fs/selinux/access 都是 0666 的
+ * "策略查询"接口，任意 app 都能把 context 字符串写进来：内核解析成功
+ * 就说明该类型存在于当前策略中。它们不需要 root，也不受 /proc/kallsyms、
+ * /data/adb 这类路径可见性的限制，是策略枚举的一条盲区。
+ *
+ * 两个节点必须一起处理：上层探测代码在 context 返回 EINVAL 之后会回退到
+ * access 再试一次，只堵其中一个等于没堵。
+ *
+ * 对 root 框架相关的类型直接返回 -EINVAL，行为与"策略里根本没有这个
+ * 类型"完全一致：调用方拿到的是 EINVAL 而不是 EACCES，不会因为权限不足
+ * 而暴露异常，多次探测的结果也保持稳定。
+ *
+ * 只匹配类型名前缀，不碰 system_data_file 之类正常类型，因此上层用来
+ * 判断"接口是否可信"的哨兵探针不受影响。
+ */
+static bool zn_context_is_hidden(const char *buf, size_t size)
+{
+	static const char * const hidden[] = {
+		"u:r:ksu:",
+		"u:r:ksud:",
+		"u:r:ksu_exec:",
+		"u:r:kernelsu:",
+		"u:object_r:ksu",
+		"u:object_r:kernelsu",
+		"u:r:magisk:",
+		"u:object_r:magisk_file:",
+	};
+	size_t i;
+
+	/* 写入方可能带前导空白或换行 */
+	while (size > 0 && isspace(*buf)) {
+		buf++;
+		size--;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(hidden); i++) {
+		size_t n = strlen(hidden[i]);
+
+		if (size >= n && !strncmp(buf, hidden[i], n))
+			return true;
+	}
+
+	return false;
+}
+/* ---- selinuxfs probe hide end ---- */
+
 static ssize_t sel_write_context(struct file *file, char *buf, size_t size)
 {
 	struct selinux_fs_info *fsi = file_inode(file)->i_sb->s_fs_info;
@@ -687,6 +736,11 @@
 			      SECCLASS_SECURITY, SECURITY__CHECK_CONTEXT, NULL);
 	if (length)
 		goto out;
+
+	if (zn_context_is_hidden(buf, size)) {
+		length = -EINVAL;
+		goto out;
+	}
 
 	length = security_context_to_sid(state, buf, size, &sid, GFP_KERNEL);
 	if (length)
