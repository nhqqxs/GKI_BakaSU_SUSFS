-
-	if (!status)
+	struct selinux_fs_info *zn_fsi = file_inode(filp)->i_sb->s_fs_info;
+	struct page *zn_status;
+
+	zn_init_fake_status(zn_fsi->state);
+	if (zn_fake_status) {
+		filp->private_data = zn_fake_status;
+		return 0;
+	}
+
+	zn_status = selinux_kernel_status_page(zn_fsi->state);
+	if (!zn_status)
 		return -ENOMEM;
 
-	filp->private_data = status;
+	filp->private_data = zn_status;
 
 	return 0;
+
 }
 
