+/*
+ * ---- selinuxfs probe hide begin ----
+ *
+ * /sys/fs/selinux/context 和 /sys/fs/selinux/access 都是 0666 的
+ * "策略查询"接口，任意 app 都能把 context 字符串写进来：内核解析成功
+ * 就说明该类型存在于当前策略中。它们不需要 root，也不受 /proc/kallsyms、
+ * /data/adb 这类路径可见性的限制，是策略枚举的一条盲区。
+ *
+ * 两个节点必须一起处理：上层探测代码在 context 返回 EINVAL 之后会回退
+ * 到 access 再试一次，只堵其中一个等于没堵。
+ *
+ * 只对普通 app（uid >= 10000）生效。root(0)、shell(2000)、system(1000)
+ * 以及各类系统守护进程的查询保持原样，否则 LSPosed 的 zygisk 注入、
+ * KernelSU 自身的环境探测会因为拿到 EINVAL 而误判成"没有 root 环境"。
+ *
+ * 对被隐藏的类型返回 -EINVAL，行为与"策略里根本没有这个类型"完全一致：
+ * 调用方拿到的是 EINVAL 而不是 EACCES，不会因为权限不足而暴露异常，
+ * 多次探测的结果也保持稳定。
+ *
+ * 只匹配类型名前缀，不碰 system_data_file 之类正常类型，因此上层用来
+ * 判断"接口是否可信"的哨兵探针不受影响。
+ */
+static bool zn_context_is_hidden(const char *buf, size_t size)
+{
+	static const char * const hidden[] = {
+		"u:r:ksu:",
+		"u:r:ksud:",
+		"u:r:ksu_exec:",
+		"u:r:kernelsu:",
+		"u:object_r:ksu",
+		"u:object_r:kernelsu",
+		"u:r:magisk:",
+		"u:object_r:magisk_file:",
+	};
+	size_t i;
+
+	/* 特权进程一律放行，避免影响 LSPosed / ksud 的环境探测 */
+	if (current_uid().val < 10000)
+		return false;
+
+	/* 写入方可能带前导空白或换行 */
+	while (size > 0 && isspace(*buf)) {
+		buf++;
+		size--;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(hidden); i++) {
+		size_t n = strlen(hidden[i]);
+
+		if (size >= n && !strncmp(buf, hidden[i], n))
+			return true;
+	}
+
+	return false;
+}
