+/*
+ * ---- selinux priv-probe mask begin ----
+ *
+ * 上层通过 /sys/fs/selinux/access 做"代查询"：用任意 scontext 去问
+ * 某个 root 框架域是否被授予了跨域权限，再把结果按位拼成 allowedMask。
+ * 每一位对应一条规则，例如 untrusted_app -> magisk : binder:call、
+ * shell -> su : process:transition、adbd -> adbroot : binder:call。
+ *
+ * 只要策略里存在任意一条，mask 就非 0，于是被判定为"策略跨域授权"。
+ * 这些查询没有一条是 self 查询，scontext 与 tcontext 都是不同的域，
+ * 因此不能靠 ssid == tsid 来识别，只能按域名对匹配。
+ *
+ * 对非特权进程把匹配到的查询结果清零，等价于"策略里没有这些跨域
+ * 授权"，与干净设备的表现一致。root / shell / system 按 uid 放行。
+ */
+static bool zn_is_priv_probe(const char *scon, const char *tcon)
+{
+	static const struct {
+		const char *s;
+		const char *t;
+	} pairs[] = {
+		{ "u:r:untrusted_app", "u:r:magisk" },
+		{ "u:r:untrusted_app", "u:object_r:lsposed_file" },
+		{ "u:r:system_server", "u:r:system_server" },
+		{ "u:r:fsck_untrusted", "u:r:fsck_untrusted" },
+		{ "u:r:shell", "u:r:su" },
+		{ "u:r:adbd", "u:r:adbroot" },
+		{ "u:r:magisk", "u:r:droidspacesd" },
+		{ "u:r:su", "u:r:droidspacesd" },
+	};
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(pairs); i++) {
+		if (!strncmp(scon, pairs[i].s, strlen(pairs[i].s)) &&
+		    !strncmp(tcon, pairs[i].t, strlen(pairs[i].t)))
+			return true;
+	}
+
+	return false;
+}
+/* ---- selinux priv-probe mask end ---- */
+
 static ssize_t sel_write_context(struct file *file, char *buf, size_t size)
 {
 	struct selinux_fs_info *fsi = file_inode(file)->i_sb->s_fs_info;
@@ -942,6 +985,16 @@
 		goto out;
 
 	security_compute_av_user(state, ssid, tsid, tclass, &avd);
+
+	/*
+	 * 把 root 框架特有跨域授权查询的结果清零，使上层拼出的
+	 * allowedMask 为 0（等价于干净策略）。root/shell/system 放行。
+	 */
+	if (current_uid().val >= 10000 && zn_is_priv_probe(scon, tcon)) {
+		avd.allowed = 0;
+		pr_info_ratelimited("zn: priv-probe masked (%s -> %s)\n",
+				    scon, tcon);
+	}
 
