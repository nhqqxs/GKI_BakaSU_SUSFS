+/*
+ * ---- zn hidden context begin ----
+ *
+ * /proc/self/attr/current 的写入路径有两级检查：先 avc_has_perm(SETCURRENT)，
+ * 再 security_context_to_sid()。类型存在但 kernel 对其 check_context 被拒时
+ * 返回 -EACCES，类型不存在才返回 -EINVAL。上层据此区分"存在但无权"和
+ * "根本不存在"，所以隐藏时必须给出 EINVAL，否则反而确认了类型的存在。
+ *
+ * 这里在解析之前直接对 root 框架类型返回 -EINVAL，与"策略里没有这个
+ * 类型"完全一致。只匹配类型名前缀，不碰普通类型。
+ */
+static bool zn_ctx_hidden(const char *buf, size_t size)
+{
+	static const char * const hidden[] = {
+		"u:r:ksu:",
+		"u:r:ksud:",
+		"u:r:ksu_exec:",
+		"u:r:kernelsu:",
+		"u:object_r:ksu",
+		"u:object_r:kernelsu",
+		"u:r:magisk:",
+		"u:object_r:magisk_file:",
+		"u:object_r:lsposed_file:",
+		"u:r:droidspacesd:",
+		"u:r:msd_app:",
+		"u:r:msd_daemon:",
+		"u:object_r:xposed_data:",
+		"u:object_r:xposed_file:",
+		"u:r:adbroot:",
+	};
+	size_t i;
+
+	while (size > 0 && isspace(*buf)) {
+		buf++;
+		size--;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(hidden); i++) {
+		size_t n = strlen(hidden[i]);
+
+		if (size >= n && !strncmp(buf, hidden[i], n))
+			return true;
+	}
+
+	return false;
+}
+/* ---- zn hidden context end ---- */
