+/*
+ * ---- zn hidden context begin ----
+ *
+ * DirtySepolicy 风格的探测在 /proc/self/attr/current、/sys/fs/selinux/context、
+ * /sys/fs/selinux/access 三个节点上都用 errno 区分语义：
+ *   -EACCES / -EPERM  表示"类型存在但无权操作"
+ *   -EINVAL           表示"类型无法解析/不存在"
+ * 因此隐藏时必须统一给出 -EINVAL，否则 EACCES/EPERM 反而坐实了类型存在。
+ *
+ * 只对普通 app（uid >= 10000）生效。root(0)、shell(2000)、system(1000)
+ * 以及 LSPosed 的 lspd/zygisk 注入流程都要按真实语义切换域，放行它们
+ * 才不会破坏框架加载；而探针 carrier（app_zygote，uid 是 app uid）仍被拦截。
+ */
+static bool zn_ctx_hidden(const char *buf, size_t size)
+{
+	static const char * const hidden[] = {
+		"u:r:ksu:",
+		"u:r:ksud:",
+		"u:r:ksu_exec:",
+		"u:r:kernelsu:",
+		"u:r:kp:",
+		"u:object_r:ksu",
+		"u:object_r:kernelsu",
+		"u:r:magisk:",
+		"u:object_r:magisk_file:",
+		"u:object_r:lsposed_file:",
+		"u:r:droidspacesd:",
+		"u:r:msd_app:",
+		"u:r:msd_daemon:",
+		"u:object_r:xposed_data:",
+		"u:object_r:xposed_file:",
+		
+		"u:r:adbroot:",
+		"u:r:zygisk:",
+		"u:r:zygiskd:",
+	};
+	size_t i;
+
+	/* 特权进程一律放行，避免影响 LSPosed / ksud / su 的域切换 */
+	if (current_uid().val < 10000)
+		return false;
+
+	while (size > 0 && (*buf == ' ' || *buf == '\t' ||
+			    *buf == '\n' || *buf == '\r')) {
+		buf++;
+		size--;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(hidden); i++) {
+		size_t n = strlen(hidden[i]);
+
+		if (size >= n && !strncmp(buf, hidden[i], n))
+			return true;
+	}
+
+	return false;
+}
+/* ---- zn hidden context end ---- */
